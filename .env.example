# 공통
APP_NAME=RemoteHelp
# 비워 두면 접속한 주소를 그대로 쓴다. 개발 중 localhost 와 내부망 IP 를 함께 쓸 때 편하다.
# 운영 서버에서는 실제 주소를 반드시 적는다.
APP_BASE_URL=
# 고객에게 보내는 주소(https://<도메인>/<조직코드>)의 기준. 비우면 접속한 주소를 쓴다.
# 상담원이 localhost 나 내부 IP 로 콘솔을 열어도 고객에게는 이 주소가 나간다.
PUBLIC_BASE_URL=

# DB
DB_HOST=db
DB_PORT=3306
DB_NAME=remotehelp
DB_USER=remotehelp
DB_PASS=change-me-db-password
DB_ROOT_PASS=change-me-root-password

# CI3 암호화 키 (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-64-hex-chars

# 중계 서버
RELAY_SERVER_NAME=localhost
RELAY_AGENT_WS_URL=wss://localhost:8443/agent
# auto: 접속한 포털 주소 기준 ws(s)://<호스트>/relay-viewer 로 포털을 거쳐 relay 에 붙는다(자체 서명 인증서를 쓰는 시험 서버)
RELAY_VIEWER_WS_URL=wss://localhost:8443/viewer
RELAY_AUTH_SHARED_SECRET=change-me-relay-secret

# 상담 실시간 메시지 서버 (realtime-msg 컨테이너)
# 비워 두면 접속한 주소의 REALTIME_PUBLIC_PORT 를 쓴다. 운영에서는 nginx 로 wss 를 종단하고 그 주소를 적는다.
REALTIME_WS_URL=
REALTIME_PUBLIC_PORT=8091
REALTIME_PUBLISH_URL=http://realtime-msg:8091/publish
REALTIME_SHARED_SECRET=change-me-realtime-secret
# 구독 토큰 서명 키 (openssl rand -hex 32)
REALTIME_TOKEN_SECRET=change-me-64-hex-chars

# 홍보 페이지 문의처 (비워 두면 화면에 표시하지 않는다)
CONTACT_EMAIL=
CONTACT_PHONE=

# 소개 페이지의 상담 위젯을 응대할 조직 코드. 그 조직에서 위젯을 켜야 버블이 보인다.
LANDING_WIDGET_ORG=system

# 메일 발송 (상담 위젯 오프라인 알림)
# SMTP_HOST 를 비워 두면 메일을 보내지 않는다. 개발 환경 기본값이다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls
SMTP_FROM=no-reply@example.com

# Microsoft Store
STORE_PRODUCT_ID=0000000000000000

# 직접 다운로드(EXE) 배포 경로
# 코드 서명 인증서가 준비되기 전까지는 꺼 둔다. 자세한 내용은 docs/code-signing.md
DIRECT_DOWNLOAD_ENABLED=false

# 런처 배포
LAUNCHER_MIN_VERSION=1.0.0

# Cloudflare Tunnel (https://help.wani.im -> web). 토큰은 Cloudflare Zero Trust > Networks > Tunnels 에서 발급
# 켜려면 COMPOSE_PROFILES=tunnel 도 함께 둔다.
CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
