# 공통
APP_NAME=RemoteHelp
APP_BASE_URL=http://localhost:8099/

# DB
DB_HOST=db
DB_PORT=3306
DB_NAME=remotehelp
DB_USER=remotehelp
DB_PASS=change-me-db-password
DB_ROOT_PASS=change-me-root-password

# CI3 암호화 키 (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-64-hex-chars

# 중계 서버
RELAY_HOST=localhost
RELAY_TLS_PORT=5501
RELAY_WS_URL=wss://localhost:8443/ws
RELAY_AUTH_SHARED_SECRET=change-me-relay-secret

# Microsoft Store
STORE_PRODUCT_ID=0000000000000000

# 런처 배포
LAUNCHER_MIN_VERSION=1.0.0
