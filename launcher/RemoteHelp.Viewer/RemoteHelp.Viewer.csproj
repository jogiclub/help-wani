<Project Sdk="Microsoft.NET.Sdk">
  <!--
    파일 위치: launcher/RemoteHelp.Viewer/RemoteHelp.Viewer.csproj
    역할: 상담원용 뷰어(WPF + WebView2) 프로젝트 정의. 포털 상담원 콘솔을 전용 창으로 띄운다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoteHelpViewer</AssemblyName>
    <RootNamespace>RemoteHelp.Viewer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>ko-KR</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 는 System.IO 를 암시적 using 에서 뺀다. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
</Project>
