<Project Sdk="Microsoft.NET.Sdk">
  <!--
    파일 위치: launcher/RemoteHelp.App/RemoteHelp.App.csproj
    역할: 고객 런처(WPF) 프로젝트 정의
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoteHelp</AssemblyName>
    <RootNamespace>RemoteHelp</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>ko-KR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UltraVNC 실행 파일은 저장소에 포함하지 않는다.
      launcher/vendor/ultravnc 에 배치한 뒤 빌드 시 출력 폴더로 복사한다.
      배치 방법은 launcher/vendor/README.md 참고.
    -->
    <None Include="..\vendor\ultravnc\**\*.*" Condition="Exists('..\vendor\ultravnc')">
      <Link>ultravnc\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
