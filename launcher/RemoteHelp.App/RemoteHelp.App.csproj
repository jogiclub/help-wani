<Project Sdk="Microsoft.NET.Sdk">
  <!--
    파일 위치: launcher/RemoteHelp.App/RemoteHelp.App.csproj
    역할: 고객 런처(WPF) 프로젝트 정의
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoteHelp</AssemblyName>
    <RootNamespace>RemoteHelp</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>ko-KR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      동봉한 UltraVNC(1.8.3.0 x64)를 빌드 출력의 ultravnc\ 폴더로 복사한다.
      런처는 AppContext.BaseDirectory\ultravnc\winvnc.exe 를 실행한다.
      구성과 출처는 launcher/vendor/README.md 참고.
    -->
    <None Include="..\vendor\ultravnc\**\*.*" Exclude="..\vendor\ultravnc\SHA256SUMS">
      <Link>ultravnc\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
