<?xml version="1.0" encoding="utf-8"?>
<!--
  파일 위치: launcher/RemoteHelp.Package/Package.appxmanifest
  역할: MSIX 패키지 선언 (runFullTrust, remotehelp 프로토콜)
  주의: Identity 의 Name/Publisher 는 Partner Center 에서 앱 이름을 예약한 뒤 그 값으로 바꿔야 한다.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="CompanyName.RemoteHelp"
    Publisher="CN=CompanyName, O=CompanyName, C=KR"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>RemoteHelp 원격지원</DisplayName>
    <PublisherDisplayName>CompanyName</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>상담원이 고객 PC 를 원격으로 지원하기 위한 연결 프로그램입니다.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
  </Resources>

  <Applications>
    <Application Id="RemoteHelp" Executable="RemoteHelp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="RemoteHelp 원격지원"
        Description="상담원이 고객 PC 를 원격으로 지원하기 위한 연결 프로그램입니다."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"
                         Square71x71Logo="Images\SmallTile.png"
                         Square310x310Logo="Images\LargeTile.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- 고객 접속 페이지의 "앱 열기" 버튼이 사용하는 프로토콜 -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="remotehelp">
            <uap:DisplayName>RemoteHelp 원격지원 연결</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 동봉한 원격지원 엔진(winvnc.exe)을 실행하기 위해 필요 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
