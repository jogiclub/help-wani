# 파일 위치: server/systemd/uvncrepeater.service
# 역할: UltraVNC Repeater(Linux 포크) 데몬 등록
[Unit]
Description=RemoteHelp UltraVNC Repeater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 리피터는 시작 시 스스로 uvncrep 계정으로 권한을 낮춘다(설정의 runasuser).
ExecStart=/usr/local/bin/uvncrepeater-ac /etc/uvncrepeater-ac.ini
Restart=always
RestartSec=3
StandardOutput=append:/var/log/remotehelp/repeater.log
StandardError=append:/var/log/remotehelp/repeater.log

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/remotehelp

[Install]
WantedBy=multi-user.target
