# 환경설정
.env
*.local.env

# 의존성/벤더
/portal/assets/vendor/novnc/
/vendor/

# 빌드 도구 (scripts/build-css.sh 가 필요할 때 내려받는다)
/.tools/

# 빌드 산출물
/launcher/**/bin/
/launcher/**/obj/
/launcher/**/AppPackages/
*.pfx
*.cer

# 도커 볼륨/인증서
/docker/certs/
/data/

# 로그
*.log
/logs/

# 에디터
.vscode/
.idea/
.DS_Store
portal/application/cache/
portal/assets/downloads/*.exe
portal/assets/downloads/*.sha256
# 조직이 올린 로고 (폴더만 유지)
portal/assets/uploads/logos/*
!portal/assets/uploads/logos/.gitkeep
portal/assets/uploads/guides/*
!portal/assets/uploads/guides/.gitkeep

# 파이썬 캐시
__pycache__/
*.pyc
