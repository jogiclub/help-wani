# 환경설정
.env
*.local.env

# 의존성/벤더
/backend/assets/vendor/novnc/
/vendor/


# 빌드 산출물
/launcher/**/bin/
/launcher/**/obj/
/launcher/**/AppPackages/
*.pfx
*.cer

# 도커 볼륨/인증서
/docker/certs/
/data/

# 로그
*.log
/logs/

# 에디터
.vscode/
.idea/
.DS_Store
backend/assets/downloads/*.exe
backend/assets/downloads/*.sha256
# 조직이 올린 로고 (폴더만 유지)
backend/assets/uploads/logos/*
!backend/assets/uploads/logos/.gitkeep
backend/assets/uploads/guides/*
!backend/assets/uploads/guides/.gitkeep

# 파이썬 캐시
__pycache__/
*.pyc
