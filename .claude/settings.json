{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/post-edit-check.py\"",
            "timeout": 60,
            "statusMessage": "프로젝트 규칙 검사 중"
          }
        ]
      }
    ]
  }
}
